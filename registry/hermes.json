{
  "name": "hermes",
  "label": "Hermes Agent",
  "description": "Nous Hermes Agent — self-improving AI with tools, profiles, memory, and messaging",
  "homepage": "https://github.com/NousResearch/hermes-agent",
  "tags": [
    "coding",
    "tools",
    "orchestration",
    "profiles"
  ],
  "featured": true,
  "order": 6,
  "builtin": true,
  "logo": {
    "key": "hermes"
  },
  "support": {
    "install": true,
    "workspace": true,
    "collaboration": true
  },
  "install": {
    "binary": "hermes",
    "requires": [
      "python3",
      "git"
    ],
    "macos": "curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh | bash -s -- --skip-setup",
    "linux": "curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh | bash -s -- --skip-setup",
    "windows": "\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -Command \"Invoke-RestMethod -UseBasicParsing 'https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.ps1' | Invoke-Expression\""
  },
  "uninstall": null,
  "adapter": null,
  "launch": {
    "args": []
  },
  "check_ready": {
    "creds_file": "~/.hermes/config.yaml",
    "creds_no_parse": true,
    "status_command": "hermes status",
    "login_command": "hermes setup",
    "not_ready_message": "Hermes not configured — run: hermes setup"
  },
  "env_config": [
    {
      "name": "LLM_API_KEY",
      "description": "API key for a custom OpenAI-compatible endpoint (optional if you sign in with `hermes setup`)",
      "required": false,
      "password": true
    },
    {
      "name": "LLM_BASE_URL",
      "description": "Custom OpenAI-compatible base URL (leave empty to use Hermes's own provider login)",
      "required": false,
      "placeholder": "https://api.openai.com/v1"
    },
    {
      "name": "LLM_MODEL",
      "description": "Model name served by the endpoint above",
      "required": false
    }
  ],
  "models": [
    {
      "id": "anthropic/claude-sonnet-4.6",
      "label": "Claude Sonnet 4.6 (Nous Portal)",
      "category": "chat"
    },
    {
      "id": "openai/gpt-5.5-pro",
      "label": "GPT-5.5 Pro (Nous Portal)",
      "category": "chat"
    },
    {
      "id": "deepseek/deepseek-v4-pro",
      "label": "DeepSeek V4 Pro (Nous Portal)",
      "category": "chat"
    },
    {
      "id": "google/gemini-3-pro-preview",
      "label": "Gemini 3 Pro Preview (Nous Portal)",
      "category": "chat"
    }
  ],
  "vendor": "Nous Research",
  "tagline": "Self-improving agent with tools and profiles.",
  "resolve_env": {
    "rules": [
      {
        "from": "LLM_API_KEY",
        "to": "OPENAI_API_KEY"
      }
    ]
  }
}
