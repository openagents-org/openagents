{
  "name": "claude",
  "label": "Claude Code CLI",
  "description": "Anthropic's official CLI agent for Claude",
  "homepage": "https://claude.ai/claude-code",
  "tags": [
    "coding",
    "cli",
    "anthropic"
  ],
  "featured": true,
  "order": 1,
  "builtin": true,
  "logo": {
    "key": "claude"
  },
  "support": {
    "install": true,
    "workspace": true,
    "collaboration": true
  },
  "install": {
    "binary": "claude",
    "requires": [
      "nodejs",
      "git"
    ],
    "macos": "npm install -g @anthropic-ai/claude-code",
    "linux": "npm install -g @anthropic-ai/claude-code",
    "windows": "npm install -g @anthropic-ai/claude-code"
  },
  "uninstall": {
    "macos": "npm uninstall -g @anthropic-ai/claude-code",
    "linux": "npm uninstall -g @anthropic-ai/claude-code",
    "windows": "npm uninstall -g @anthropic-ai/claude-code"
  },
  "adapter": {
    "module": "openagents.adapters.claude",
    "class": "ClaudeAdapter"
  },
  "launch": {
    "args": [
      "--append-system-prompt",
      "Your agent name is '{agent_name}'."
    ]
  },
  "check_ready": {
    "env_vars": [
      "ANTHROPIC_API_KEY"
    ],
    "creds_file": "~/.claude/sessions",
    "creds_key": null,
    "keychain_service": "Claude Code-credentials",
    "not_ready_message": "Not logged in. Run: claude login",
    "login_command": "claude login",
    "alt_check": "claude --print hi"
  },
  "env_config": [],
  "models": {
    "provider": "anthropic"
  },
  "vendor": "Anthropic",
  "tagline": "The gold standard for agentic coding, right in your terminal."
}
