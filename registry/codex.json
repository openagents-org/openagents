{
  "name": "codex",
  "label": "OpenAI Codex CLI",
  "description": "OpenAI's coding agent for the terminal",
  "homepage": "https://github.com/openai/codex",
  "tags": [
    "coding",
    "openai",
    "cli"
  ],
  "featured": true,
  "order": 3,
  "builtin": true,
  "logo": {
    "key": "codex"
  },
  "support": {
    "install": true,
    "workspace": true,
    "collaboration": true
  },
  "install": {
    "binary": "codex",
    "requires": [
      "nodejs"
    ],
    "macos": "npm install -g @openai/codex",
    "linux": "npm install -g @openai/codex",
    "windows": "npm install -g @openai/codex"
  },
  "uninstall": {
    "macos": "npm uninstall -g @openai/codex",
    "linux": "npm uninstall -g @openai/codex",
    "windows": "npm uninstall -g @openai/codex"
  },
  "adapter": {
    "module": "openagents.adapters.codex",
    "class": "CodexAdapter"
  },
  "launch": {
    "args": [
      null
    ]
  },
  "check_ready": {
    "env_all": [
      "OPENAI_API_KEY",
      "OPENAI_BASE_URL"
    ],
    "saved_env_all": [
      "OPENAI_API_KEY",
      "OPENAI_BASE_URL"
    ],
    "status_command": "codex login status",
    "login_command": "codex login",
    "unverifiable": true,
    "not_ready_message": "Not configured. Set OPENAI_API_KEY + OPENAI_BASE_URL, or run: codex login"
  },
  "env_config": [
    {
      "name": "OPENAI_API_KEY",
      "description": "OpenAI API key (optional if using Codex subscription via 'codex login')",
      "required": false,
      "password": true
    },
    {
      "name": "OPENAI_BASE_URL",
      "description": "OpenAI-compatible base URL (optional if using Codex subscription)",
      "required": false
    }
  ],
  "models": {
    "provider": "openai"
  },
  "resolve_env": {
    "rules": [
      {
        "from": "LLM_API_KEY",
        "to": "OPENAI_API_KEY"
      },
      {
        "from": "LLM_BASE_URL",
        "to": "OPENAI_BASE_URL"
      },
      {
        "from": "LLM_MODEL",
        "to": "CODEX_MODEL"
      }
    ]
  },
  "vendor": "OpenAI",
  "tagline": "GPT-5.5 powered engineering from OpenAI."
}
