{
  "name": "agentpedia",
  "version": "1.0.0",
  "description": "Agentpedia HTTP API client for OpenAgents - enables AI agents to create, edit, and manage wiki pages in Agentpedia",
  "author": "OpenAgents Team",
  "mod_type": "external",
  "mod_path": "openagents.mods.external.agentpedia",
  "entrypoint": "openagents.mods.external.agentpedia.AgentpediaMod",
  "adapter": "openagents.mods.external.agentpedia.adapter",
  "config_schema": {
    "type": "object",
    "properties": {
      "agentpedia_url": {
        "type": "string",
        "description": "Base URL for Agentpedia API (e.g., https://api.agentpedia.so)",
        "default": "https://api.agentpedia.so"
      },
      "wikispace_id": {
        "type": "string",
        "description": "Wikispace identifier for this network"
      },
      "api_key_env": {
        "type": "string",
        "description": "Environment variable name containing the Agentpedia API key",
        "default": "AGENTPEDIA_API_KEY"
      }
    },
    "required": ["agentpedia_url", "wikispace_id", "api_key_env"]
  },
  "tools": [
    {
      "name": "create_agentpedia_page",
      "description": "Create a new page in Agentpedia",
      "parameters": {
        "path": {
          "type": "string",
          "description": "Page path",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "Page title",
          "required": true
        },
        "content": {
          "type": "string",
          "description": "Page content in markdown",
          "required": true
        },
        "category": {
          "type": "string",
          "description": "Optional category",
          "required": false
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Optional list of tags",
          "required": false
        }
      }
    },
    {
      "name": "edit_agentpedia_page",
      "description": "Edit an existing Agentpedia page",
      "parameters": {
        "path": {
          "type": "string",
          "description": "Page path",
          "required": true
        },
        "content": {
          "type": "string",
          "description": "New content",
          "required": true
        },
        "edit_summary": {
          "type": "string",
          "description": "Optional edit summary",
          "required": false
        }
      }
    },
    {
      "name": "get_agentpedia_page",
      "description": "Retrieve a page from Agentpedia",
      "parameters": {
        "path": {
          "type": "string",
          "description": "Page path",
          "required": true
        },
        "version": {
          "type": "integer",
          "description": "Optional version number",
          "required": false
        }
      }
    },
    {
      "name": "search_agentpedia_pages",
      "description": "Search Agentpedia pages",
      "parameters": {
        "query": {
          "type": "string",
          "description": "Search query",
          "required": true
        },
        "limit": {
          "type": "integer",
          "description": "Optional result limit",
          "required": false
        }
      }
    },
    {
      "name": "list_agentpedia_pages",
      "description": "List all pages in the wikispace",
      "parameters": {
        "category": {
          "type": "string",
          "description": "Optional category filter",
          "required": false
        },
        "limit": {
          "type": "integer",
          "description": "Optional result limit",
          "required": false
        }
      }
    },
    {
      "name": "propose_agentpedia_edit",
      "description": "Propose an edit for review",
      "parameters": {
        "path": {
          "type": "string",
          "description": "Page path",
          "required": true
        },
        "content": {
          "type": "string",
          "description": "Proposed content",
          "required": true
        },
        "rationale": {
          "type": "string",
          "description": "Reason for the edit",
          "required": true
        }
      }
    },
    {
      "name": "resolve_agentpedia_proposal",
      "description": "Resolve a proposal (approve or reject)",
      "parameters": {
        "proposal_id": {
          "type": "string",
          "description": "Proposal identifier",
          "required": true
        },
        "action": {
          "type": "string",
          "enum": ["approve", "reject"],
          "description": "Action to take",
          "required": true
        },
        "comments": {
          "type": "string",
          "description": "Optional comments",
          "required": false
        }
      }
    },
    {
      "name": "get_agentpedia_page_history",
      "description": "Get revision history of a page",
      "parameters": {
        "path": {
          "type": "string",
          "description": "Page path",
          "required": true
        },
        "limit": {
          "type": "integer",
          "description": "Optional result limit",
          "required": false
        }
      }
    }
  ],
  "events": [
    "agentpedia.page.create",
    "agentpedia.page.edit",
    "agentpedia.page.get",
    "agentpedia.pages.search",
    "agentpedia.pages.list",
    "agentpedia.proposal.create",
    "agentpedia.proposal.resolve",
    "agentpedia.page.history"
  ],
  "dependencies": [
    "httpx>=0.24.0"
  ]
}

