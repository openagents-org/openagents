# Public HTTPS origin the platforms call back to. Must match the Request URL
# configured in the Slack app manifest / Lark event subscription / Telegram
# setWebhook. Locally, a tunnel (ngrok, cloudflared) stands in.
GATEWAY_PUBLIC_URL=https://gateway.openagents.org
PORT=8080

# The gateway's own database. Separate from the backend's: two migration tools
# pointed at one database disagree about what belongs to whom, and separating
# them costs nothing on a shared cluster.
DATABASE_URL=postgresql://postgres:dev@localhost:5433/openagents_gateway

# The OA backend and the shared secret for the two handshake endpoints where no
# binding credential exists yet, or no longer does.
OA_ENDPOINT=https://workspace-endpoint.openagents.org
OA_SERVICE_KEY=

# Encrypts platform credentials at rest: openssl rand -base64 32
# Durable state, not a config knob — rotating it means re-running OAuth.
GATEWAY_ENCRYPTION_KEY=

# Identifies this replica when it takes a drain lease. Railway supplies
# RAILWAY_REPLICA_ID; anything unique per process works.
GATEWAY_INSTANCE_ID=

# Seconds between liveness checks on the event stream. Not a polling interval —
# outbound is stream-driven — this only catches a connection that stayed open
# while data stopped arriving. 0 disables it.
GATEWAY_WATCHDOG_SECONDS=60

# How long one replica holds the right to drain a binding.
GATEWAY_LEASE_SECONDS=120

LOG_LEVEL=info
