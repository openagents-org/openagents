[Unit]
Description=Build and deploy isolated OpenAgents preview from the develop branch
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/openagents-preview-track-branch
TimeoutStartSec=2400
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
Environment=GIT_TERMINAL_PROMPT=0
Environment=PREVIEW_BRANCH=develop
UMask=0077
