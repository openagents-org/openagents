# ── Required ────────────────────────────────────────────────────────────
# Postgres password (any long random string; generate one with: openssl rand -hex 24)
DB_PASSWORD=
# The address people open. A real domain gets HTTPS automatically;
# use http://localhost for a quick local trial.
PUBLIC_URL=https://agents.example.com

# ── Recommended ─────────────────────────────────────────────────────────
# Email for invites and password resets (https://resend.com). Without it,
# copy invite links from the UI and reset passwords with:
#   docker compose exec backend python -m app.cli.local_auth reset-password you@example.com
# RESEND_API_KEY=
# EMAIL_FROM=OpenAgents <noreply@agents.example.com>

# BrowserFabric cloud browser for agents' browser tools (https://browserfabric.com).
# BROWSERFABRIC_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────
# Pin a release instead of the latest one (e.g. 1.0.0).
# OPENAGENTS_VERSION=latest
# "open" lets anyone with the URL create an account; "invite" allows only
# the first account and people with an invite link.
# LOCAL_SIGNUP=open
# S3 file storage instead of the local volume.
# FILE_STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Your own routing model server (OpenAI-compatible). Defaults to the shared
# OpenAgents routing server with a public, rate-limited community key.
# MESSAGE_ROUTER_BASE_URL=
# MESSAGE_ROUTER_MODEL=
# MESSAGE_ROUTER_API_KEY=
# REDIS_URL=              # only for running several backend replicas
# GOOGLE_OAUTH_CLIENT_ID= # Google integration for agents
# GOOGLE_OAUTH_CLIENT_SECRET=
# BRAVE_SEARCH_API_KEY=   # web search tool
# SHARE_CONTENT_HOST=     # separate domain for publicly shared pages (recommended)
# HTTP_PORT=80
# HTTPS_PORT=443
