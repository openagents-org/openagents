{
  "name": "kimi",
  "label": "Kimi",
  "description": "Kimi agent powered by Moonshot AI, OpenAI-compatible API.",
  "homepage": "https://platform.moonshot.ai",
  "tags": [
    "coding",
    "moonshot",
    "open-source"
  ],
  "featured": true,
  "order": 7,
  "builtin": true,
  "logo": {
    "key": "kimi"
  },
  "support": {
    "install": true,
    "workspace": true,
    "collaboration": true
  },
  "install": {
    "binary": "kimi",
    "api_only": true,
    "macos": "echo 'Kimi uses direct API mode — no binary install needed'",
    "linux": "echo 'Kimi uses direct API mode — no binary install needed'",
    "windows": "echo 'Kimi uses direct API mode — no binary install needed'"
  },
  "uninstall": null,
  "adapter": {
    "module": "openagents.adapters.kimi",
    "class": "KimiAdapter"
  },
  "launch": {
    "args": []
  },
  "check_ready": {
    "env_vars": [
      "KIMI_API_KEY",
      "MOONSHOT_API_KEY"
    ],
    "saved_env_key": "KIMI_API_KEY",
    "not_ready_message": "No API key — press e to configure"
  },
  "env_config": [
    {
      "name": "KIMI_API_KEY",
      "description": "Moonshot/Kimi API key (also accepts MOONSHOT_API_KEY env var)",
      "required": true,
      "password": true
    },
    {
      "name": "KIMI_BASE_URL",
      "description": "Kimi API base URL (OpenAI-compatible endpoint)",
      "required": false,
      "default": "https://api.moonshot.ai/v1",
      "placeholder": "https://api.moonshot.ai/v1"
    },
    {
      "name": "KIMI_MODEL",
      "description": "Kimi model name",
      "required": false,
      "default": "kimi-k2.6",
      "placeholder": "kimi-k2.6"
    }
  ],
  "models": [
    {
      "id": "kimi-k3",
      "label": "Kimi K3",
      "category": "chat"
    },
    {
      "id": "kimi-k2.7-code",
      "label": "Kimi K2.7 Code",
      "category": "chat"
    },
    {
      "id": "kimi-k2.7-code-highspeed",
      "label": "Kimi K2.7 Code High-Speed",
      "category": "chat"
    },
    {
      "id": "kimi-k2.6",
      "label": "Kimi K2.6",
      "category": "chat"
    }
  ],
  "vendor": "Moonshot AI",
  "tagline": "Moonshot-powered agent, OpenAI-compatible."
}
