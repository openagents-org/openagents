{
  "name": "kimi",
  "label": "Kimi Code CLI",
  "description": "Kimi Code CLI — Moonshot AI's terminal coding agent.",
  "homepage": "https://moonshotai.github.io/kimi-code",
  "tags": [
    "coding",
    "cli",
    "moonshot",
    "open-source"
  ],
  "featured": true,
  "order": 7,
  "builtin": true,
  "logo": {
    "key": "kimi"
  },
  "support": {
    "install": true,
    "workspace": true,
    "collaboration": true
  },
  "install": {
    "binary": "kimi",
    "requires": [
      "nodejs"
    ],
    "verify": "kimi --version",
    "verify_win": "kimi --version",
    "macos": "npm install -g @moonshot-ai/kimi-code",
    "linux": "npm install -g @moonshot-ai/kimi-code",
    "windows": "npm install -g @moonshot-ai/kimi-code"
  },
  "uninstall": null,
  "adapter": {
    "module": "openagents.adapters.kimi",
    "class": "KimiAdapter"
  },
  "launch": {
    "args": []
  },
  "check_ready": {
    "env_vars": [
      "KIMI_API_KEY",
      "MOONSHOT_API_KEY"
    ],
    "saved_env_key": "KIMI_API_KEY",
    "login_command": "kimi login",
    "not_ready_message": "Not configured — set an API key (press e) or run: kimi login"
  },
  "env_config": [
    {
      "name": "KIMI_API_KEY",
      "description": "Moonshot/Kimi API key (also accepts MOONSHOT_API_KEY). Leave blank to use `kimi login`.",
      "required": false,
      "password": true
    },
    {
      "name": "KIMI_BASE_URL",
      "description": "Kimi API base URL (OpenAI-compatible endpoint)",
      "required": false,
      "default": "https://api.moonshot.ai/v1",
      "placeholder": "https://api.moonshot.ai/v1"
    },
    {
      "name": "KIMI_MODEL",
      "description": "Kimi model name",
      "required": false,
      "default": "kimi-k2.6",
      "placeholder": "kimi-k2.6"
    }
  ],
  "resolve_env": {
    "rules": [
      {
        "from": "LLM_API_KEY",
        "to": "KIMI_API_KEY"
      },
      {
        "from": "LLM_BASE_URL",
        "to": "KIMI_BASE_URL"
      },
      {
        "from": "LLM_MODEL",
        "to": "KIMI_MODEL"
      }
    ]
  },
  "models": [
    {
      "id": "kimi-k3",
      "label": "Kimi K3",
      "category": "chat"
    },
    {
      "id": "kimi-k2.7-code",
      "label": "Kimi K2.7 Code",
      "category": "chat"
    },
    {
      "id": "kimi-k2.7-code-highspeed",
      "label": "Kimi K2.7 Code High-Speed",
      "category": "chat"
    },
    {
      "id": "kimi-k2.6",
      "label": "Kimi K2.6",
      "category": "chat"
    }
  ],
  "vendor": "Moonshot AI",
  "tagline": "Moonshot AI's Kimi Code CLI coding agent."
}
