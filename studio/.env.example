# Server Configuration
HOST=0.0.0.0
PORT=8050
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Interview Hub Mode Configuration
# When enabled, the Studio will show a simplified login page
# that collects user information (first name, last name, email)
# and automatically connects to the configured network.

# Enable Interview Hub Mode (true/false)
# REACT_APP_INTERVIEW_HUB_MODE=true

# Interview Hub Network Host
# REACT_APP_INTERVIEW_HUB_HOST=localhost

# Interview Hub Network Port
# REACT_APP_INTERVIEW_HUB_PORT=8700
