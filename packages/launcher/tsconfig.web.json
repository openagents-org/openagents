{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    // See tsconfig.node.json — tsc type-checks only, electron-vite builds.
    "noEmit": true,
    // No `baseUrl`: it is deprecated in TS 6 and removed in TS 7. Path mappings
    // resolve relative to this file when it is omitted.
    "paths": {
      "@renderer/*": ["./src/renderer/*"]
    }
  },
  "include": ["src/shared/**/*", "src/renderer/**/*"]
}
