{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    // See tsconfig.node.json — tsc type-checks only, electron-vite builds.
    "noEmit": true,
    // No `baseUrl`: it is deprecated in TS 6 and removed in TS 7. Path mappings
    // resolve relative to this file when it is omitted.
    "paths": {
      "@renderer/*": ["./src/renderer/*"],
      "@/*": ["../../workspace/frontend/*"]
    }
  },
  "include": ["src/shared/**/*", "src/renderer/**/*", "../../workspace/frontend/components/agents/agent-setup.tsx", "../../workspace/frontend/components/ui/button.tsx", "../../workspace/frontend/components/ui/input.tsx", "../../workspace/frontend/components/ui/label.tsx", "../../workspace/frontend/components/ui/select.tsx", "../../workspace/frontend/components/icons/agent-icons.tsx", "../../workspace/frontend/lib/i18n/**/*", "../../workspace/frontend/lib/node-path.ts", "../../workspace/frontend/lib/utils.ts", "../../workspace/frontend/lib/types.ts"]
}
