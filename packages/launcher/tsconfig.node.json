{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "composite": true,
    // electron-vite (esbuild) produces the actual bundles; tsc is only ever run
    // for type checking. Without this, `tsc -b` emits .js/.d.ts next to every
    // source file, littering src/ with hundreds of untracked artifacts.
    "noEmit": true,
    "types": ["electron-vite/node", "node"]
  },
  // electron.vite.config.ts is deliberately excluded: it is an ESM build config
  // that imports ESM-only plugins (@tailwindcss/vite ships .mts types), which
  // cannot resolve under the commonjs/node settings the main process needs.
  // electron-vite transpiles it with esbuild at build time, so tsc never has to.
  "include": ["src/shared/**/*", "src/main/**/*", "src/preload/**/*"]
}
